# Copy to .env.local (gitignored) and fill in. NEVER commit real secrets.

# Sanity CMS (Phase 1 — blog/news/courses)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Resend (enquiry email delivery — /api/enquiry)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=

# Magnific (image generation for marketing assets — used off-site, not at runtime)
# Rotate the key if it has ever been shared in plaintext.
MAGNIFIC_API_KEY=
